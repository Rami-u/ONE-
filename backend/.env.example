DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_ENABLE_API_DOCS=True
DJANGO_ADMIN_PATH=platform-admin/
# Set to 1 in production when Django is behind exactly one trusted reverse proxy.
DRF_NUM_PROXIES=0
# Invitation and password-reset links expire after this many seconds (default: 3 days).
PASSWORD_RESET_TIMEOUT_SECONDS=259200
PLATFORM_BASE_DOMAIN=edunova.com
PLATFORM_URL_SCHEME=https
# Local development only; production must keep this True.
DJANGO_SESSION_COOKIE_SECURE=False
POSTGRES_DB=educational_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CSRF_TRUSTED_ORIGINS=https://*.edunova.com
# Local development uses the console backend; production should use the SMTP backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-your-smtp-user
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
